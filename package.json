{
  "name": "derived-d3-collapsible-tree",
  "version": "2.0.0",
  "description": "A collapsible D3 tree with lazy loading, selection, zoom and an accordion mode. TypeScript, D3 v7.",
  "keywords": [
    "d3",
    "tree",
    "collapsible",
    "lazy-loading",
    "hierarchy",
    "svg"
  ],
  "author": "Tiago Câmara",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velovsky/Derived-D3.js-Collapsible-Tree.git"
  },
  "homepage": "https://velovsky.github.io/Derived-D3.js-Collapsible-Tree/",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/collapsible-tree.js",
  "module": "./dist/collapsible-tree.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/collapsible-tree.js"
    },
    "./style.css": "./dist/collapsible-tree.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build && tsc -p tsconfig.build.json && cp src/collapsible-tree.css dist/",
    "build:demo": "vite build --mode demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
